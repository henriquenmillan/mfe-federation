{
  "name": "mfe-federation",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:all": "run-p start:shell start:mfe-cadastro start:mfe-sucesso",
    "start:shell": "ng serve shell --port 4200",
    "start:mfe-cadastro": "ng serve mfe-cadastro --port 4201",
    "start:mfe-sucesso": "ng serve mfe-sucesso --port 4202",
    "build:shell": "ng build shell --configuration production",
    "build:mfe-cadastro": "ng build mfe-cadastro --configuration production",
    "build:mfe-sucesso": "ng build mfe-sucesso --configuration production",
    "build:all": "ng build shell && ng build mfe-cadastro && ng build mfe-sucesso",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "run:all": "node node_modules/@angular-architects/module-federation/src/server/mf-dev-server.js"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/module-federation": "^18.0.6",
    "@angular/animations": "^18.2.0",
    "@angular/cdk": "^18.2.14",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/material": "^18.2.14",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.20",
    "@angular/cli": "^18.2.20",
    "@angular/compiler-cli": "^18.2.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.2.0",
    "json-server": "^1.0.0-beta.3",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ngx-build-plus": "^18.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.5.2"
  }
}
